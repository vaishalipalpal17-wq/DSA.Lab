#include <stdio.h>
#include <string.h>
#include <ctype.h>

#define MAX 100

char stack[MAX];
int top = -1;

void push(char c) {
    stack[++top] = c;
}

char pop() {
    return stack[top--];
}

int priority(char c) {
    if (c == '^')
        return 3;
    if (c == '*' || c == '/')
        return 2;
    if (c == '+' || c == '-')
        return 1;
    return 0;
}

void reverse(char str[]) {
    int i, j;
    char temp;

    for (i = 0, j = strlen(str) - 1; i < j; i++, j--) {
        temp = str[i];
        str[i] = str[j];
        str[j] = temp;
    }
}

int main() {
    char infix[MAX], prefix[MAX];
    int i, j = 0;
    char c;

    printf("Enter infix expression: ");
    scanf("%s", infix);

    reverse(infix);

    for (i = 0; infix[i] != '\0'; i++) {
        if (infix[i] == '(')
            infix[i] = ')';
        else if (infix[i] == ')')
            infix[i] = '(';
    }

    top = -1;

    for (i = 0; infix[i] != '\0'; i++) {
        c = infix[i];

        if (isalnum(c)) {
            prefix[j++] = c;
        }
        else if (c == '(') {
            push(c);
        }
        else if (c == ')') {
            while (top != -1 && stack[top] != '(')
                prefix[j++] = pop();
            pop();
        }
        else {
            while (top != -1 && stack[top] != '(' &&
                   priority(stack[top]) > priority(c))
                prefix[j++] = pop();
            push(c);
        }
    }

    while (top != -1)
        prefix[j++] = pop();

    prefix[j] = '\0';

    reverse(prefix);

    printf("Prefix expression: %s\n", prefix);

    return 0;
}
