#include <stdio.h>
#include <stdlib.h>
#define MAX 100

int queue[MAX];
int f = -1, r = -1;

void enqueue(int value) {
    if (r == MAX - 1) {
        printf("Queue Overflow\n");
    } else {
        if (f == -1)
            f = 0;
        queue[++r] = value;
    }
}

void dequeue() {
    if (f == -1) {
        printf("Queue Underflow\n");
    } else {
        printf("Deleted element: %d\n", queue[f++]);
        if (f > r)
            f = r = -1;
    }
}

void display() {
    int i;

    if (f == -1) {
        printf("Queue is empty\n");
    } else {
        for (i = f; i <= r; i++)
            printf("%d ", queue[i]);
        printf("\n");
    }
}

int main() {
    int choice, value;

    while (1) {
        printf("\n1. Enqueue\n2. Dequeue\n3. Display\n4. Exit\n");
        printf("Enter choice: ");
        scanf("%d", &choice);

        switch (choice) {
            case 1:
                printf("Enter value: ");
                scanf("%d", &value);
                enqueue(value);
                break;

            case 2:
                dequeue();
                break;

            case 3:
                display();
                break;

            case 4:
                exit(0);

            default:
                printf("Invalid choice\n");
        }
    }

    return 0;
}
